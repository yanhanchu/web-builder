                  {
                    "heading": {
                      "mode": "literal",
                      "value": "1. Information we collect"
                    },
                    "body": [
                      {
                        "mode": "literal",
                        "value": "Account information you provide (such as name and email) when you sign up or contact us."
                      },
                      {
                        "mode": "literal",
                        "value": "Content you create or upload when using our products."
                      },
                      {
                        "mode": "literal",
                        "value": "Usage and device data (such as IP address, browser type, and basic analytics) to operate and improve the service."
                      }
                    ]
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "2. How we use information"
                    },
                    "body": [
                      {
                        "mode": "literal",
                        "value": "To provide and maintain our products."
                      },
                      {
                        "mode": "literal",
                        "value": "To respond to support requests and communicate with you about your account."
                      },
                      {
                        "mode": "literal",
                        "value": "To improve performance, security and the user experience."
                      }
                    ]
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "3. Sharing"
                    },
                    "body": [
                      {
                        "mode": "literal",
                        "value": "We don't sell your personal information."
                      },
                      {
                        "mode": "literal",
                        "value": "We use trusted infrastructure and service providers (for example hosting, email and analytics) who process data on our behalf under appropriate agreements."
                      },
                      {
                        "mode": "literal",
                        "value": "We may disclose information if required by law."
                      }
                    ]
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "4. Data location and transfers"
                    },
                    "body": {
                      "mode": "literal",
                      "value": "Text to Mind Map is operated from Australia and may use providers located in other regions. Where data is transferred internationally, we take reasonable steps to ensure it's handled with comparable protections."
                    }
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "5. Security"
                    },
                    "body": [
                      {
                        "mode": "literal",
                        "value": "We use industry-standard practices to protect your information, including encryption in transit and access controls."
                      },
                      {
                        "mode": "literal",
                        "value": "No system is perfectly secure, so we encourage you to use strong, unique passwords."
                      }
                    ]
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "6. Your rights"
                    },
                    "body": [
                      {
                        "mode": "literal",
                        "value": "You can request access to, correction of, or deletion of personal information we hold about you by emailing support@txt2map.com."
                      },
                      {
                        "mode": "literal",
                        "value": "If you're in a region with specific data rights (such as the EU or UK), those rights apply where required by law."
                      }
                    ]
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "7. Cookies"
                    },
                    "body": [
                      {
                        "mode": "literal",
                        "value": "We use a minimal set of cookies and similar technologies to keep the site working and understand high-level usage."
                      },
                      {
                        "mode": "literal",
                        "value": "You can control cookies in your browser settings."
                      }
                    ]
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "8. Changes"
                    },
                    "body": {
                      "mode": "literal",
                      "value": "We may update this policy from time to time. Significant changes will be noted on this page with a new \"updated\" date."
                    }
                  },
                  {
                    "heading": {
                      "mode": "literal",
                      "value": "9. Contact"
                    },
                    "body": {
                      "mode": "literal",
                      "value": "For privacy questions or requests, email support@txt2map.com."
                    }
                  }
                ]
              }
