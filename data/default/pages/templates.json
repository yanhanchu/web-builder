                  {
                    "question": {
                      "mode": "literal",
                      "value": "How do I use one of these templates?"
                    },
                    "answer": {
                      "mode": "literal",
                      "value": "Copy the outline text for a template, open the editor, and paste it in. Each line becomes a node and the indentation becomes the map's hierarchy automatically."
                    }
                  },
                  {
                    "question": {
                      "mode": "literal",
                      "value": "Can I mix parts of different templates?"
                    },
                    "answer": {
                      "mode": "literal",
                      "value": "Yes. Paste in one template, then copy branches from another and paste them under the node where they belong — indentation is all that determines hierarchy, so pieces combine cleanly."
                    }
                  },
                  {
                    "question": {
                      "mode": "literal",
                      "value": "Do templates support colours, tags or images?"
                    },
                    "answer": {
                      "mode": "literal",
                      "value": "Templates are plain text to keep them easy to copy and adapt. Once pasted in, use the quick command menu or a node's detail panel to add colours, tags, URLs or images to any node."
                    }
                  }
                ]
