{
  "name": "web-builder",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @workspace/ui run docs:generate && pnpm --filter @workspace/ui run functions:generate && npm run pages:generate",
    "prebuild": "pnpm --filter @workspace/ui run docs:generate && pnpm --filter @workspace/ui run functions:generate && npm run pages:generate",
    "pages:generate": "node scripts/generate-pages.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@workspace/browser": "workspace:*",
    "@workspace/server": "workspace:*",
    "@workspace/ui": "workspace:*",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",

    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6",
    "vite": "^8.1.1"
  }
}
