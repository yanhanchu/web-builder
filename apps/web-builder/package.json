{
  "name": "web-builder",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm run docs:generate && pnpm run functions:generate",
    "prebuild": "pnpm run docs:generate && pnpm run functions:generate",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "docs:generate": "node scripts/docs/generate-docs.mjs",
    "functions:generate": "node scripts/docs/generate-functions-docs.mjs",
    "generate:split-jsx": "vite-node ./scripts/site-generator/cli-split-jsx.ts",
    "generate:astro": "vite-node ./scripts/site-generator/cli-astro.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4",
    "@workspace/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "glob": "^13.0.6",
    "oxlint": "^1.71.0",
    "react-docgen-typescript": "^2.4.0",
    "ts-morph": "^25.0.1",
    "typescript": "~6",
    "vite": "^8.1.1",
    "vite-node": "^3.0.0"
  }
}
