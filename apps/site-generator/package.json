{
  "name": "site-generator",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "讀取攤平匯出的資料（i18n / route / file / typedData / pages / locales / styleSheets），驅動 @workspace/ui 既有的 page-model + site-renderer，產出全靜態 React/TSX 網站（每個 locale x page 一份 HTML + 對應的水合腳本）。",
  "scripts": {
    "generate:split-jsx": "vite-node ./src/cli-split-jsx.ts --data ../../../data/default #--out ../../../dist",
    "generate:astro": "vite-node ./src/cli-astro.ts --data ../../../data/default #--out ../../../dist-astro",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/ui": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4",
    "typescript": "~6",
    "vite": "^8.1.1",
    "vite-node": "^3.0.0"
  }
}
