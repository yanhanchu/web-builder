{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:generate": "node scripts/generate-docs.mjs",
    "functions:generate": "node scripts/generate-functions-docs.mjs",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource-variable/oxanium": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "glob": "^13.0.6",
    "oxlint": "^1.71.0",
    "react-docgen-typescript": "^2.4.0",
    "tailwindcss": "^4",
    "ts-morph": "^25.0.1",
    "typescript": "~6"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
