# Copy this file to .env.local (gitignored) and fill in real values.

# URL of the backend's login page. The frontend redirects the browser here
# to sign in; the backend ONLY records the login event and redirects back
# to this app with `?credential=<google id token>`. It is never contacted
# again after that — no session, no refresh, no sync happens through it.
VITE_LOGIN_URL=https://your-backend.example.com/login

# Google OAuth 2.0 Client ID (from Google Cloud Console), used client-side
# by Google Identity Services to request/refresh a Drive appdata-scoped
# access token directly from Google. Must be an "OAuth client ID" of type
# "Web application", with this app's origin registered under
# "Authorized JavaScript origins".
VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- S3-compatible object storage (multi-file upload demo) ---
# See docs/storage-module.md for the full write-up, including why signing
# happens client-side here and what that means for secret exposure.
#
# VITE_S3_KIND selects only how the URL is built:
#   custom -> path-style URL against VITE_S3_ENDPOINT (e.g. self-hosted S2)
#   r2     -> virtual-hosted-style URL against a Cloudflare R2 endpoint
#   aws    -> standard AWS S3 virtual-hosted URL, VITE_S3_ENDPOINT unused
VITE_S3_KIND=custom
VITE_S3_ENDPOINT=http://192.168.123.11:9000
VITE_S3_REGION=us-east-1
VITE_S3_BUCKET=app.base
VITE_S3_ACCESS_KEY_ID=your-access-key-id
VITE_S3_SECRET_ACCESS_KEY=your-secret-access-key
# Leave unset to use the VITE_S3_KIND default (path-style for custom/aws,
# virtual-hosted for r2). Override explicitly only if your endpoint is unusual.
# VITE_S3_FORCE_PATH_STYLE=true
