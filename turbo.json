{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "docs:generate": {
      "cache": false,
      "outputs": ["data/**", "src/lib/generator/component-map.ts", "src/types/generator/function-types.ts"]
    },
    "functions:generate": {
      "cache": false,
      "outputs": ["data/**", "src/lib/generator/component-map.ts", "src/types/generator/function-types.ts"]
    },
    "build": {
      "dependsOn": ["^build", "^docs:generate", "^functions:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
